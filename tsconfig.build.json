{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    // The sources are not published, so the maps carry them
    "inlineSources": true
  },
  "include": ["src"]
}
